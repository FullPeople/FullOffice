<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FullOffice</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FlowOffice.ico</ApplicationIcon>
    <Version>0.3.4</Version>
    <Product>FullOffice</Product>
    <Description>FullOffice 文档、表格、演示文稿与 PDF 工作台</Description>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>FlowOfficeLab.Program</StartupObject>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <Target Name="PinSelfContainedRuntime" BeforeTargets="ProcessFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
  <ItemGroup>
    <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF"
      Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net8.0'">
      <LatestRuntimeFrameworkVersion>8.0.31</LatestRuntimeFrameworkVersion>
    </KnownFrameworkReference>
    <KnownAppHostPack Update="Microsoft.NETCore.App"
      Condition="'%(KnownAppHostPack.TargetFramework)' == 'net8.0'">
      <AppHostPackVersion>8.0.31</AppHostPackVersion>
    </KnownAppHostPack>
  </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <None Include="$(PkgTesseract)/x64/*.dll" Link="x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ocr-data/*.traineddata;ocr-data/LICENSE;ocr-data/provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/icon-64.png" />
    <EmbeddedResource Include="Assets/ONLYOFFICE-logo.svg" LogicalName="FullOffice.ONLYOFFICELogo" />
    <EmbeddedResource Include="Assets/Templates/blank.pptx" LogicalName="FullOffice.BlankPresentation" />
    <None Include="../../licenses/python-pptx-template-MIT.txt" Link="licenses/python-pptx-template-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/ocr/*" Link="licenses/ocr/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/ONLYOFFICE-AGPL-3.0.txt;../../licenses/ONLYOFFICE-NOTICE.txt;../../licenses/CC-BY-SA-4.0.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <None Include="pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
